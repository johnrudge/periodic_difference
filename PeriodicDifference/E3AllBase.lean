/-
# `PeriodicDifference/E3AllBase.lean` — the base case of `thm:allodd-e3all`, `k ≤ 90`

The finite check of the paper's proof of `thm:allodd-e3all` at the orders `12 ≤ k ≤ 90`
(smaller orders have no support with two elements below `k/2` and `1 ∉ S`).  Each row
`(k, F_k, D_k)` of `baseData` (`E3AllBaseC*`, generated by `tools/emit_e3all.py`) passes `rowCheck`:
every odd pair outside `F_k` has a witness (`ftCheck`), and every support met by the enumeration
`gen` (411 in all) is one of the twelve supports of `tab:allodd-base` with two elements below `k/2`
or satisfies the three-point condition (T) with a multiplier from `D_k` (`BaseCheck`).
-/
import PeriodicDifference.E3AllBaseC0
import PeriodicDifference.E3AllBaseC1
import PeriodicDifference.E3AllBaseC2
import PeriodicDifference.E3AllBaseC3

namespace PeriodicDifference
namespace Trop
namespace Bump
namespace E3All

open Shadow

/-- The base data at the orders `12, 14, …, 90`. -/
def baseData : List BaseRow := baseC0 ++ baseC1 ++ baseC2 ++ baseC3

theorem baseData_orders : baseData.map (·.1) = List.range' 12 40 2 := by
  decide +kernel

/-- **The base case of `thm:allodd-e3all`.**  At even `k ≤ 90`, every primitive
all-odd palindromic `S` with `1 ∉ S` and at least two elements below `k/2` is in
`tab:allodd-base` or has a unit satisfying (T). -/
theorem base_e3 {k a : ℕ} {S : Finset ℕ} (hk : k ≤ 90)
    (hb : AllOddPal k S a) (hP : PerSupport.Prim k S) (h1 : 1 ∉ S)
    (hL : ∃ x ∈ S, 2 * x < k ∧ x ≠ a) : (k, S) ∈ AllOddBase.tabKS ∨ ∃ d, E3 k S a d := by
  have he := hb.even_k
  have h12 : 12 ≤ k := by
    obtain ⟨x, hx, hx2, hxa⟩ := hL
    have := hb.a_min x hx
    have := hb.odd x hx
    have := hb.odd a hb.a_mem
    have : a ≠ 1 := fun h => h1 (h ▸ hb.a_mem)
    have := hb.mem a hb.a_mem
    omega
  have hmem : k ∈ baseData.map (·.1) := by
    rw [baseData_orders, List.mem_range']
    exact ⟨(k - 12) / 2, by omega, by omega⟩
  obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hmem
  have hc := List.all_eq_true.mp
    (by simp only [baseData, List.all_append, baseC0_ok, baseC1_ok, baseC2_ok, baseC3_ok,
      Bool.and_self] : baseData.all rowCheck = true) r hr
  simp only [rowCheck, Bool.and_eq_true, decide_eq_true_eq] at hc
  exact e3_of_checks hc.1 hc.2 hb hP h1 hL

end E3All
end Bump
end Trop
end PeriodicDifference
