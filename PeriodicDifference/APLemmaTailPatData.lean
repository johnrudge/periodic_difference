def LPl : List ℕ := [17, 19, 23, 29, 31, 37, 41, 43]

/-- `∑_{i<r} ⌈m / LP_i⌉`. -/
def unionSum (m r : ℕ) : ℕ := ∑ i ∈ Finset.range r, (m + LPl.getD i 0 - 1) / LPl.getD i 0

/-- `∏_{i<r} LP_i`. -/
def lpProd (r : ℕ) : ℕ := ∏ i ∈ Finset.range r, LPl.getD i 0

/-- The numeric checks of one entry `(A, r, m, c)`. -/
