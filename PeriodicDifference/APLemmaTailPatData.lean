  decide (unionSum m r < c) &&
  (A % 2 != 0 || decide (178*m^2 ≤ 10*max (A*lpProd r) (A*(2730/A + 1)))) &&
  (decide (m ≤ 8) || decide (1000*m < 102*(A*lpProd r)))

