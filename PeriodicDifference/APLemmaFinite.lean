theorem good_finite {k : ℕ} (h1 : 92 ≤ k) (h2 : k ≤ 2730) (h3 : k % 2 = 0) {a e : ℤ}
    (h : Adm k a e) : Good k a e := by
  have hk := List.all_eq_true.1 orders_ok k
    (List.mem_range'.2 ⟨(k - 92) / 2, by omega, by omega⟩)
  simp only [orderOK1, orderOK, Bool.or_eq_true] at hk
  rcases hk with hk | hk | hk
  · exact good_twoPrime h1 (twoPrime_of_B (by omega) hk) h
  · unfold jacRoute at hk
