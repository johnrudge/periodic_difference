/-- Two consecutive runs of even orders. -/
theorem all_range'_append {f : ℕ → Bool} {s m s' n N : ℕ}
    (h₁ : (List.range' s m 2).all f = true) (h₂ : (List.range' s' n 2).all f = true)
    (hs : s + 2 * m = s' := by norm_num) (hN : m + n = N := by norm_num) :
    (List.range' s N 2).all f = true := by
  subst hs hN
  rw [← List.range'_append, List.all_append, h₁, h₂, Bool.and_self]

