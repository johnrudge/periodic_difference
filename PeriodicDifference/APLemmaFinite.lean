      exact (hcov ℓ hℓ hd).resolve_right fun h1 => hℓ.one_lt.ne' (Nat.dvd_one.1 h1)
    · exact absurd hk (by simp)
  · exact good_of_cert h (cert_all hJT_all hCT_all ct_complete h2 hk)

